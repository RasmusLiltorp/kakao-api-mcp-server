# Kakao REST API key (required).
# Register an app at https://developers.kakao.com/ and enable the
# "Local" / Kakao Map service plus Daum Search.
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# ODsay API key (optional, required for odsay_find_transit_route).
# Register at https://lab.odsay.com/.
ODSAY_API_KEY=your_odsay_api_key_here

# Referer sent with ODsay requests. Set this only if your ODsay key is
# registered against a web URI; the value must match that URI.
# ODSAY_REFERER=https://your-registered-domain.example
