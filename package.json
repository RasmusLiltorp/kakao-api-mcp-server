{
  "name": "korea-travel-mcp",
  "version": "2.0.0",
  "description": "MCP server for Korean travel and local search: Kakao Map, Kakao Mobility, ODsay public transit, and Daum search. Fork of jeong-sik/kakao-api-mcp-server.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "korea-travel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --mode=stdio",
    "start:http": "node dist/index.js --mode=http",
    "dev": "tsx watch src/index.ts --mode=stdio"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kakao",
    "odsay",
    "korea",
    "transit",
    "maps"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.8.4",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "yargs": "^18.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
